{
  "enabledMcpjsonServers": ["chrome-devtools"],
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -Rf:*)",
      "Bash(rm -r -f:*)",
      "Bash(rm -f -r:*)",
      "Bash(sudo rm -rf:*)",
      "Bash(gh repo delete:*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(curl * | sudo sh*)",
      "Bash(curl * | sudo bash*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)",
      "Bash(cat .env*)",
      "Bash(cat */.env*)",
      "Bash(source .env*)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-destructive.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-unsafe.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "in=$(cat); printf '%s' \"$in\" | python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/log-prompts.py\"; bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/auto-commit-push.sh\"",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
